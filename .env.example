# Password untuk login ke /admin (pakai yang panjang dan unik)
ADMIN_PASSWORD=

# Kunci rahasia untuk menandatangani sesi login (minimal 32 karakter).
# Buat dengan: openssl rand -base64 32
SESSION_SECRET=

# Diisi otomatis kalau database Upstash Redis dipasang lewat Vercel (Storage).
# Nama KV_REST_API_URL / KV_REST_API_TOKEN juga didukung.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alamat dashboard admin. Isi path rahasia (huruf kecil, angka, minus), contoh: panel-ema-7x2k
# Kalau diisi, /admin jadi 404 dan dashboard hanya bisa dibuka di go.emahairshop.com/<path ini>.
# Kosongkan untuk tetap memakai /admin. Perlu deploy ulang setelah diubah.
NEXT_PUBLIC_ADMIN_PATH=
