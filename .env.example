# Password untuk login ke /admin (pakai yang panjang dan unik)
ADMIN_PASSWORD=

# Kunci rahasia untuk menandatangani sesi login (minimal 32 karakter).
# Buat dengan: openssl rand -base64 32
SESSION_SECRET=

# Diisi otomatis kalau database Upstash Redis dipasang lewat Vercel (Storage).
# Nama KV_REST_API_URL / KV_REST_API_TOKEN juga didukung.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alamat halaman login (opsional). Isi path rahasia: huruf kecil, angka, minus. Contoh: masuk-ema-7x2k
# Kalau diisi, login hanya bisa dibuka di go.emahairshop.com/<path ini>, dan /admin tampil 404
# untuk yang belum login. Setelah login, dashboard tetap di /admin. Kosongkan untuk memakai /admin/login.
LOGIN_PATH=
